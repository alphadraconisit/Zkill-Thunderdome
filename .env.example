# --- Storage -----------------------------------------------------------------
# Hosted Turso database. Get these from the Turso CLI:
#   turso db show <name> --url
#   turso db tokens create <name>
# Leave both blank for local development and the board uses a file under DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Only used when TURSO_DATABASE_URL is empty.
DATA_DIR=./data

# --- Security ----------------------------------------------------------------
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Password for the /admin area (submitting and deleting killmails).
# If unset, the admin area is disabled entirely.
ADMIN_PASSWORD=

# Bearer token for POST /api/killmails. If unset, the write API is disabled.
API_KEY=

# Optional: gate the entire site behind a password (fully private killboard).
# Leave empty for a public, readable board.
SITE_PASSWORD=

# --- Board -------------------------------------------------------------------
BOARD_NAME=Thunderdome

# Resolve ship names to EVE type IDs via ESI so ship renders show up.
# Set to 0 for a fully offline board (placeholder art instead).
ESI_LOOKUP=1

PORT=3000

<%- include('partials/header') %>

<% if (anchored) { %>
  <div class="anchornote">
    <span>
      Reporting on <strong>one detected battle</strong> &mdash;
      <%= h.num(report.summary.killmails) %> killmails in <%= anchored.system %>,
      <%= h.formatDuration(anchored.durationMs) %> from <%= h.clock(anchored.start) %>.
    </span>
    <a class="btn ghost" href="/battle/report<%= h.buildQuery({}, { from: window.fromInput, to: window.toInput, system: system || null }) %>">
      Edit as a custom window
    </a>
  </div>
<% } else { %>
<form class="filterbar" method="get" action="/battle/report">
  <div class="filterfield">
    <label for="from">From &mdash; EVE time (UTC)</label>
    <input type="datetime-local" id="from" name="from" value="<%= window.fromInput %>">
  </div>
  <div class="filterfield">
    <label for="to">To &mdash; EVE time (UTC)</label>
    <input type="datetime-local" id="to" name="to" value="<%= window.toInput %>">
  </div>
  <div class="filterfield">
    <label for="system">System</label>
    <input list="systemlist" id="system" name="system" value="<%= system || '' %>" placeholder="All systems"
           autocomplete="off">
    <datalist id="systemlist">
      <% systems.forEach((s) => { %><option value="<%= s.label %>"></option><% }) %>
    </datalist>
  </div>
  <button class="btn" type="submit">Build report</button>

  <div class="presets">
    <% Object.entries(presets).forEach(([key, value]) => { %>
      <a class="pg <%= preset === key ? 'current' : '' %>"
         href="/battle/report<%= h.buildQuery(system ? { system } : {}, { preset: key }) %>"><%= value.label %></a>
    <% }) %>
  </div>

  <%# The date widget renders in the viewer's locale format, so spell the
      window out — otherwise a non-UTC reader reads it as an offset clock. %>
  <p class="filterhint">
    Searching <strong><%= h.formatDateLong(window.from) %></strong>
    to <strong><%= h.formatDateLong(window.to) %></strong> EVE time
    <span class="dim">(<%= duration %> window<%= system ? `, ${system} only` : ', all systems' %>)</span>
  </p>
</form>
<% } %>

<p class="crumb"><a href="/battle">&larr; All detected battles</a></p>

<% if (!report.summary.killmails) { %>
  <section class="panel">
    <h1 class="panel-title">Battle report</h1>
    <p class="empty">
      No killmails between <%= h.formatDateLong(window.from) %> and <%= h.formatDateLong(window.to) %><%
        %><% if (system) { %> in <%= system %><% } %>.
      Widen the window or clear the system filter.
    </p>
  </section>
<% } else { %>

  <%# Battle header: which fight, when, and the headline counts. %>
  <section class="battlehead">
    <div class="battleplace">
      <span class="battleplace-mark" aria-hidden="true">&#9678;</span>
      <div>
        <h1><%= report.summary.systems.length === 1 ? report.summary.systems[0] : 'Multiple systems' %></h1>
        <% if (report.summary.systems.length === 1) { %>
          <a class="battleplace-sub" href="/system/<%= encodeURIComponent(report.summary.systems[0]) %>">System overview</a>
        <% } else { %>
          <span class="battleplace-sub dim"><%= report.summary.systems.slice(0, 3).join(', ') %><%= report.summary.systems.length > 3 ? '…' : '' %></span>
        <% } %>
        <div class="battleplace-when">
          <span class="tz">EVE</span>
          <%= h.clock(report.summary.start) %> &mdash; <%= h.clock(report.summary.end) %>
          <span class="dim"><%= h.formatDate(report.summary.start).slice(0, 10) %></span>
        </div>
      </div>
    </div>

    <div class="battlefigures">
      <div class="bigfig">
        <span class="bigfig-n accent"><%= h.chartNumber(report.summary.damage) %></span>
        <span class="bigfig-l">total damage</span>
      </div>
      <div class="bigfig">
        <span class="bigfig-n"><%= h.num(report.summary.killmails) %></span>
        <span class="bigfig-l">ships lost</span>
      </div>
      <div class="bigfig">
        <span class="bigfig-n"><%= h.num(report.summary.pilots) %></span>
        <span class="bigfig-l">participants</span>
      </div>
      <div class="bigfig">
        <span class="bigfig-n"><%= h.formatDuration(report.summary.durationMs) %></span>
        <span class="bigfig-l">duration</span>
      </div>
    </div>
  </section>

  <% if (truncated) { %>
    <div class="alert info">
      This window hit the <%= h.num(limit) %>-killmail cap, so the report covers only the
      earliest <%= h.num(limit) %>. Narrow the time range for a complete picture.
    </div>
  <% } %>

  <% if (!anchored && contained.length > 1) { %>
    <div class="alert info">
      <strong>This window covers <%= contained.length %> separate battles</strong>, so the
      figures below add them together. Open one on its own:
      <ul class="battlelinks">
        <% contained.forEach((b) => { %>
          <li>
            <a href="<%= b.url %>"><%= b.system %> &middot; <%= h.clock(b.start) %>&ndash;<%= h.clock(b.end) %></a>
            <span class="dim">
              <%= h.num(b.killCount) %> ships, <%= h.num(b.pilotCount) %> pilots,
              <%= h.formatDuration(b.durationMs) %>
            </span>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <%# One panel per side, side by side, matching the timeline colours. %>
  <div class="sidegrid">
    <% report.teams.forEach((team, i) => { %>
      <% const topPilotDamage = Math.max(1, ...team.pilots.map((p) => p.damageDone)); %>
      <section class="sidepanel" style="--team: <%= h.seriesColor(i) %>" data-side>
        <header class="sidepanel-head">
          <span class="sidecrest" style="background: <%= h.tintFor(team.label) %>"><%= h.initials(team.label) %></span>
          <div class="sidepanel-id">
            <h2>
              <% if (h.entityUrl(team.kind, team.label)) { %>
                <a href="<%= h.entityUrl(team.kind, team.label) %>"><%= team.label %></a>
              <% } else { %><%= team.label %><% } %>
            </h2>
            <%# The reference board shows an alliance ticker here; killmail text
                carries no tickers, so this states what the side actually is. %>
            <span class="sideteam"><%= team.kind %><% if (team.corpCount > 1) { %> &middot; <%= team.corpCount %> corps<% } %></span>
          </div>
          <% if (team.corpCount > 1) { %>
            <span class="sidecorps" title="<%= team.corpList.join(', ') %>">+<%= team.corpCount - 1 %></span>
          <% } %>
        </header>

        <div class="sidedamage">
          <span class="sidedamage-n"><%= h.chartNumber(team.damageDone) %></span>
          <span class="sidedamage-l">damage dealt</span>
        </div>

        <dl class="sidestats">
          <div><dt>Pilots</dt><dd><%= h.num(team.pilotCount) %></dd></div>
          <div><dt>Ships lost</dt><dd class="bad"><%= h.num(team.losses) %></dd></div>
          <div><dt>Damage taken</dt><dd><%= h.chartNumber(team.damageTaken) %></dd></div>
          <div><dt>Kills</dt><dd class="good"><%= h.num(team.kills) %></dd></div>
        </dl>

        <div class="sideshare" role="img"
             aria-label="<%= team.damageShare %> percent of all damage dealt">
          <span class="sideshare-fill" style="width: <%= Math.max(3, team.damageShare) %>%"></span>
          <span class="sideshare-text"><%= team.damageShare %>%</span>
        </div>

        <label class="sidefilter">
          <span class="visually-hidden">Filter <%= team.label %> pilots</span>
          <input type="search" placeholder="Filter pilots or ships&hellip;" data-side-filter autocomplete="off">
        </label>

        <ol class="crew">
          <% team.pilots.forEach((pilot) => { %>
            <% const icon = pilot.shipList.length ? esi.itemIcon(pilot.shipList[0], 32) : null; %>
            <li class="crewrow <%= pilot.shipsLost ? 'is-lost' : '' %>"
                data-crew="<%= (pilot.name + ' ' + pilot.shipList.join(' ')).toLowerCase() %>">
              <span class="crew-avatar" style="background: <%= h.tintFor(pilot.name) %>"><%= h.initials(pilot.name) %></span>

              <span class="crew-ship-icon">
                <% if (icon) { %>
                  <img src="<%= icon %>" alt="" loading="lazy" width="28" height="28">
                <% } else { %><span class="crew-ship-blank"></span><% } %>
              </span>

              <span class="crew-id">
                <a class="crew-name" href="/character/<%= encodeURIComponent(pilot.name) %>"><%= pilot.name %></a>
                <span class="crew-ship">
                  <% if (pilot.shipList.length === 1) { %><%= pilot.shipList[0] %>
                  <% } else if (pilot.shipList.length > 1) { %><%= pilot.shipList.length %> ships
                  <% } else { %>&mdash;<% } %>
                </span>
              </span>

              <span class="crew-figures">
                <span class="crew-dealt">
                  <%= h.chartNumber(pilot.damageDone) %><% if (pilot.kills) { %> <span class="crew-kills">(<%= pilot.kills %>)</span><% } %>
                </span>
                <span class="crew-recvd"><%= h.chartNumber(pilot.damageTaken) %> recvd</span>
              </span>

              <span class="crew-bar">
                <span style="width: <%= Math.round((pilot.damageDone / topPilotDamage) * 100) %>%"></span>
              </span>
            </li>
          <% }) %>
        </ol>
        <p class="crew-empty" hidden>No pilot matches that filter.</p>
      </section>
    <% }) %>
  </div>

  <% if (chart) { %>
    <section class="panel">
      <h2 class="panel-title">Damage timeline</h2>
      <%- include('partials/damagechart', { chart }) %>
    </section>
  <% } %>

  <section class="panel">
    <h2 class="panel-title">Killmails <span class="dim">(<%= kills.length %>)</span></h2>
    <div class="killlist">
      <% kills.slice().reverse().forEach((k) => { %>
        <%- include('partials/killrow', { k }) %>
      <% }) %>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
